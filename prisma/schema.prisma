// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model GeopoliticsArticle {
  id             String   @id @default(cuid())
  title          String   @unique
  slug           String   @default("")
  summary        String   @db.Text
  keyPoints      Json
  sourceArticles Json
  region         String
  tags           Json
  date           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
  @@index([createdAt])
  @@index([slug])
  @@map("geopolitics_articles")
}

model MarketsArticle {
  id             String   @id @default(cuid())
  title          String   @unique
  slug           String   @default("")
  summary        String   @db.Text
  keyPoints      Json
  sourceArticles Json
  region         String
  tags           Json
  date           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
  @@index([createdAt])
  @@index([slug])
  @@map("markets_articles")
}

model TechArticle {
  id             String   @id @default(cuid())
  title          String   @unique
  slug           String   @default("")
  summary        String   @db.Text
  keyPoints      Json
  sourceArticles Json
  region         String
  tags           Json
  date           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
  @@index([createdAt])
  @@index([slug])
  @@map("tech_articles")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  xAccessToken      String?
  xRefreshToken     String?
  xTokenExpiresAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
