// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model GeopoliticsArticle {
  id             String   @id @default(cuid())
  title          String   @unique
  slug           String   @default("")
  summary        String   @db.Text
  keyPoints      Json
  sourceArticles Json
  region         String
  tags           Json
  date           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topicId String? @map("topic_id")
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([createdAt])
  @@index([slug])
  @@map("geopolitics_articles")
}

model MarketsArticle {
  id             String   @id @default(cuid())
  title          String   @unique
  slug           String   @default("")
  summary        String   @db.Text
  keyPoints      Json
  sourceArticles Json
  region         String
  tags           Json
  date           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topicId String? @map("topic_id")
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([createdAt])
  @@index([slug])
  @@map("markets_articles")
}

model TechArticle {
  id             String   @id @default(cuid())
  title          String   @unique
  slug           String   @default("")
  summary        String   @db.Text
  keyPoints      Json
  sourceArticles Json
  region         String
  tags           Json
  date           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topicId String? @map("topic_id")
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([createdAt])
  @@index([slug])
  @@map("tech_articles")
}

model PulseArticle {
  id            String    @id @default(cuid())
  pulseSlug     String
  articleSlug   String
  title         String
  summary       String?
  body          String?
  sourceUrl     String?
  category      String
  observedStart DateTime?
  observedEnd   DateTime?
  publishedAt   DateTime?
  raw           Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([pulseSlug, articleSlug])
  @@index([pulseSlug])
  @@index([observedStart])
  @@map("pulse_articles")
}

model MacroArticle {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  // Pagination key — the archive steps through entries one day at a time,
  // ordered by this. Stored as a bare date (America/New_York) so a same-day
  // re-run upserts rather than duplicating.
  publishedDate DateTime @unique @db.Date
  body          String   @db.Text
  // Immutable rows (see the macro_articles_prevent_update trigger): a row is
  // inserted once and never updated, so there is no updatedAt — createdAt alone
  // records when the entry was written.
  createdAt     DateTime @default(now())

  @@map("macro_articles")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  xAccessToken      String?
  xRefreshToken     String?
  xTokenExpiresAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Topic {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  parentVertical String   @map("parent_vertical") // 'geopolitics' | 'markets' | 'tech'
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  geopoliticsArticles GeopoliticsArticle[]
  marketsArticles     MarketsArticle[]
  techArticles        TechArticle[]

  @@map("topics")
}

model OverviewDay {
  id            String          @id @default(cuid())
  // One row per calendar day (bare DATE, mirrors MacroArticle.publishedDate)
  // — same-day re-runs of the pipeline resolve to this row rather than
  // creating duplicates.
  publishedDate DateTime        @unique @db.Date
  context       String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  blocks        OverviewBlock[]

  @@map("overview_days")
}

model OverviewBlock {
  id          String      @id @default(cuid())
  dayId       String
  day         OverviewDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  // One of the fixed slugs in src/lib/overview-categories.ts (us, east-asia,
  // middle-east, europe, africa) — validated in app code, not a DB enum, to
  // match this schema's existing category-as-string convention.
  category    String
  title       String
  description String      @db.Text
  summary     String      @db.Text
  model       String      @default("meta-llama/Llama-3.1-8B-Instruct")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Enforces exactly one block per category per day at the DB layer.
  @@unique([dayId, category])
  @@index([category])
  @@map("overview_blocks")
}

