# FinPuls environment template
#
# Local development
# 1) Copy this file to .env.local
# 2) Fill one or more provider keys below
# 3) Restart `npm run dev` after changes
#
# Production (Vercel)
# 1) Project Settings -> Environment Variables
# 2) Add NEWSAPI_KEY, GNEWS_API_KEY, ALPHAVANTAGE_API_KEY, NEXT_PUBLIC_FMP_API_KEY
# 3) Redeploy after updating variables
#
# Production (AWS example)
# - Store keys in AWS Secrets Manager (or Parameter Store)
# - Inject values into process env at runtime during deploy/start
#
# Provider chain order: NewsAPI -> GNews -> Alpha Vantage -> Financial Modeling Prep
# Add at least one key to get live data; otherwise fallback demo stories are used.

# 1) NewsAPI (https://newsapi.org)
# Free plan note: top-headlines and rate limits apply by account tier.
NEWSAPI_KEY=

# Bing Webmaster Tools
# BING_VERIFICATION_CODE — from Bing Webmaster Tools → Meta tag verification
# INDEXNOW_KEY        — from Bing Webmaster Tools → IndexNow (also place /public/YOUR_KEY.txt)
BING_VERIFICATION_CODE=
INDEXNOW_KEY=

# 2) GNews (https://gnews.io)
# Free plan note: daily request quotas apply.
GNEWS_API_KEY=

# 3) Alpha Vantage (https://www.alphavantage.co)
# Free plan note: per-minute and daily limits apply.
ALPHAVANTAGE_API_KEY=

# 4) Financial Modeling Prep (https://financialmodelingprep.com)
# Used by the server route as an additional fallback provider.
NEXT_PUBLIC_FMP_API_KEY=

# ── Geopolitics AI Module ──────────────────────────────────────────────────

# Anthropic (https://console.anthropic.com) — used by geopolitics-service.ts
ANTHROPIC_API_KEY=

# NewsAPI (https://newsapi.org) — geopolitics article fetching
NEWS_API_KEY=

# Cron secret — protects POST /api/geopolitics/generate in production
# Generate with: openssl rand -hex 32
CRON_SECRET=

# PostgreSQL — Prisma (Supabase transaction-mode pooler)
DATABASE_URL=

# PostgreSQL — Prisma direct connection (used for migrations; no pgbouncer)
DIRECT_URL=

# ── X Auto-Poster / OAuth ─────────────────────────────────────────────────

# X app credentials
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Single-operator row used for persisted X tokens.
# The helper keys token storage by User.id and defaults to "uralsebastian".
X_OPERATOR_ID=uralsebastian

# Optional email used only when the operator row must be created.
# If omitted, the app falls back to "${X_OPERATOR_ID}@local.invalid".
X_OPERATOR_EMAIL=

# App/runtime secrets used by the X poster flows
NEXTAUTH_SECRET=
ADMIN_SECRET=
FINPULSE_KV_REST_API_URL=
FINPULSE_KV_REST_API_TOKEN=

# ── Daily Overview (QStash fan-out) ────────────────────────────────────────

# Upstash QStash (https://console.upstash.com/qstash) — used by
# overview-service.ts to fan out /api/overview/generate clusters to
# /api/overview/process, one job per cluster.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=

# Vercel Project Settings -> Deployment Protection -> "Protection Bypass for
# Automation". Required in production: QStash's callback to
# /api/overview/process targets VERCEL_URL, which sits behind Vercel
# Authentication — without this secret, the callback is redirected into
# vercel.com/login and never reaches the route.
VERCEL_AUTOMATION_BYPASS_SECRET=

# ── Resend (contact form + inbound email) ──────────────────────────────────

# Resend (https://resend.com) — used by api/contact/route.ts to send the
# contact form email, and by api/inbound-webhook/route.ts to forward
# received email.
RESEND_API_KEY=
FROM_EMAIL=
TO_EMAIL=

# Signing secret for the Resend "Received email" webhook (Emails -> Receiving
# -> Webhooks in the Resend dashboard). Starts with "whsec_". Verified via
# svix in api/inbound-webhook/route.ts.
RESEND_WEBHOOK_SECRET=

# Separate full_access API key for api/inbound-webhook/route.ts.
# emails.receiving.forward() requires full_access — the sending_access
# RESEND_API_KEY above can't call it (Resend returns 401 restricted_api_key).
RESEND_RECEIVING_API_KEY=

# Where/who api/inbound-webhook/route.ts forwards received email to/from.
# INBOUND_NOTIFY_FROM must be an address on a domain verified for sending
# in Resend.
INBOUND_NOTIFY_TO=
INBOUND_NOTIFY_FROM=
